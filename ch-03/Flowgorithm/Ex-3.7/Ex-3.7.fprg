    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="3,7&#13;&#10;Fa&#231;a um programa que pe&#231;a dois n&#250;meros inteiros. Imprima a soma destes dois n&#250;meros na tela."/>
            <declare name="num1" type="Integer" array="False" size=""/>
            <declare name="num2" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o valor do PRIMEIRO n&#250;mero: &quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite o valor do SEGUNDO n&#250;mero: &quot;" newline="True"/>
            <input variable="num2"/>
            <output expression="&quot;SOMA = &quot; &amp;(num1 + num2)" newline="True"/>
