    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="3.18&#13;&#10;Escreva um programa que leia um valor em metros, e o exiba convertido em mil&#237;metros."/>
            <declare name="medida" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor da medida em metros que dever&#225; ser convertida para seu equivalente em mil&#237;metros: &quot;" newline="True"/>
            <input variable="medida"/>
            <output expression="&quot;mm = &quot; &amp;(medida * 1000)" newline="True"/>
        </body>
    </function>
