    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="3.10&#13;&#10;Fa&#231;a um programa que calcule o aumento de um sal&#225;rio. Ele deve solicitar o valor do sal&#225;rio e a porcentagem de aumento. Exiba o valor do aumento e do novo sal&#225;rio."/>
            <declare name="salario" type="Real" array="False" size=""/>
            <declare name="reajuste" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor atual do sal&#225;rio: &quot;" newline="True"/>
            <input variable="salario"/>
            <output expression="&quot;Digite o valor do percentual de aumento a ser aplicado ao sal&#225;rio: &quot;" newline="True"/>
            <input variable="reajuste"/>
            <output expression="&quot;TOTAL AUMENTO = R$ &quot; &amp; (salario * (reajuste /100)) &amp;&quot;.&quot; &amp;ToChar(13)&amp; &quot;NOVO SAL&#193;RIO = R$ &quot; &amp; (salario + (salario * (reajuste /100)))" newline="True"/>
        </body>
    </function>
</flowgorithm>
